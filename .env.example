# Flask Configuration
SECRET_KEY=your_secret_key_here
FLASK_ENV=development

# Redis Cache Configuration (use rediss:// for TLS)
REDIS_URL=redis_url

# PostgreSQL Database Configuration
DATABASE_URL=db_url

# Server Configuration
PORT=5000
HOST=0.0.0.0

# Testing Configuration
# FLOOR_1_BOSS - Spawn a specific boss on floor 1 for testing (leave empty for normal gameplay)
# Valid boss IDs: shadow_king, storm_titan, lich_king, phoenix_queen, void_horror,
#                 world_serpent, death_incarnate, ancient_dragon, moon_spirit, chaos_lord, blood_god
# Example: FLOOR_1_BOSS=shadow_king
FLOOR_1_BOSS=
